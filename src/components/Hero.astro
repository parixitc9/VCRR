---
// The opening: the "VCRR Prompt Motion" film rebuilt in CSS. A build runs in the terminal, the screen clears,
// the V of VCRR tips onto its side to become the prompt, and the block cursor lands. Plays once.
// Without motion (reduced-motion or no JS) only the finished lockup shows.
import { chevron } from '../data/site.ts';

const log = [
  ['read', 'requirements.md'],
  ['build', 'web · mobile · desktop'],
  ['automate', 'the busywork'],
];
---

<section id="top" class="hero s-ink lines" data-hero aria-labelledby="hero-title">
  <div class="wrap grid hero-grid">
    <p class="mono meta-l">
      <span class="tag">VCRR</span> Digital software studio <span class="mu">/ founded by four partners</span>
    </p>
    <p class="mono meta-r mu" aria-hidden="true">~/vcrr — zsh</p>

    <div class="screen" aria-hidden="true">
      <ol class="term">
        <li>
          <span class="n">01</span>
          <span class="cmd">
            <svg class="pr" viewBox="0 0 122 148"><path d={chevron}></path></svg>
            <span class="typed">vcrr build --all</span><span class="cur"></span>
          </span>
        </li>
        {
          log.map(([k, v], i) => (
            <li class="o" style={`--i:${i}`}>
              <span class="n">0{i + 2}</span>
              <span class="k">{k}</span>
              <span>{v}</span>
              <b>ok</b>
            </li>
          ))
        }
        <li class="o" style="--i:3"><span class="n">05</span></li>
        <li class="o" style="--i:3">
          <span class="n">06</span>
          <span class="track"><i></i></span>
          <span class="pct"></span>
        </li>
      </ol>

      <div class="lockup">
        <span class="mk">
          <svg class="lk-chev" viewBox="0 0 122 148"><path d={chevron}></path></svg>
          <span class="lk-blk"></span>
        </span>
        <span class="lk-t">
          <span class="lk-word"><span class="lk-v">V</span>CRR</span>
          <span class="lk-tag">Software · Apps · Automation</span>
        </span>
      </div>
    </div>

    <div class="foot">
      <h1 id="hero-title" class="title">Any software, built to <span class="mark">your requirements.</span></h1>
      <div class="side">
        <p class="lead">You describe how your business works. We turn it into software: business systems, web and mobile apps, desktop tools and automation.</p>
        <p class="mono mu">Business systems · Web, mobile and desktop apps · Automation and integrations · UI/UX and brand identity</p>
        <div class="actions">
          <a class="btn" href="#contact">Start a project <span class="arr" aria-hidden="true">→</span></a>
          <a class="btn btn-ghost" href="#work">Explore our work <span class="arr" aria-hidden="true">↓</span></a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    min-height: calc(100svh - var(--nav-h));
    padding: clamp(20px, 3vw, 36px) 0 clamp(28px, 4vw, 48px);
    display: flex;
    overflow: clip;
  }
  .hero-grid {
    grid-template-rows: auto 1fr auto;
    row-gap: clamp(20px, 3vw, 40px);
  }
  .meta-l {
    grid-column: 1 / 9;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 6px 10px;
  }
  .tag {
    padding: 3px 7px;
    background: var(--accent);
    color: var(--ink);
  }
  .meta-r {
    grid-column: 9 / -1;
    text-align: right;
  }

  /* ---- the screen: terminal and lockup share one cell ---- */
  .screen {
    grid-column: 2 / -1;
    display: grid;
    align-items: center;
    min-height: clamp(200px, 32vh, 420px);
    /* --p (0..1) is set by scripts/main.ts as the hero scrolls away */
    transform: translateY(calc(var(--p, 0) * -10vh)) scale(calc(1 - var(--p, 0) * 0.08));
    opacity: calc(1 - var(--p, 0) * 0.85);
    transform-origin: 0 50%;
  }
  .term,
  .lockup {
    grid-area: 1 / 1;
  }

  .term {
    display: grid;
    gap: 0.45em;
    font: 400 clamp(0.7rem, 1.2vw, 1.1rem) / 1.4 var(--mono);
  }
  .term li {
    display: grid;
    grid-template-columns: 3ch 9ch 24ch 3ch;
    column-gap: 1ch;
    align-items: center;
    min-height: 1.4em;
  }
  .n {
    color: rgb(243 237 227 / 0.28);
  }
  .k {
    color: var(--mu);
  }
  .term b {
    font-weight: 500;
    color: var(--accent);
  }
  .cmd {
    grid-column: 2 / -1;
    display: flex;
    align-items: center;
    gap: 0.8ch;
    font-weight: 500;
  }
  .pr {
    height: 0.9em;
    width: auto;
    fill: var(--paper);
  }
  .typed {
    display: inline-block;
    overflow: hidden;
    white-space: nowrap;
  }
  .cur {
    width: 0.62em;
    height: 1.15em;
    margin-left: 0.15ch;
    background: var(--accent);
  }
  .track {
    grid-column: 2 / 4;
    height: 0.5em;
    background: rgb(243 237 227 / 0.12);
  }
  .track i {
    display: block;
    height: 100%;
    background: var(--accent);
    transform-origin: 0 50%;
  }
  .pct {
    counter-reset: pct var(--pct);
    color: var(--mu);
  }
  .pct::after {
    content: counter(pct) '%';
  }

  /* ---- the lockup, measured in em of the wordmark ---- */
  .lockup {
    /* where the chevron sits while it still reads as the V of VCRR: a calibration knob for the font */
    --vx: 1.87em;
    --vy: -0.16em;
    --vs: 0.85;
    display: flex;
    align-items: flex-start;
    gap: 0.58em;
    font-size: clamp(2.6rem, 10vw, 9.5rem);
  }
  .mk {
    position: relative;
    flex: none;
    width: 1.27em;
    height: 1em;
  }
  .lk-chev {
    position: absolute;
    left: 0;
    top: 0;
    height: 1em;
    width: auto;
    fill: var(--paper);
  }
  .lk-blk {
    position: absolute;
    left: 0.945em;
    bottom: 0;
    width: 0.324em;
    height: 0.284em;
    background: var(--accent);
  }
  .lk-t {
    display: grid;
    gap: 0.2em;
  }
  .lk-word {
    font: 800 1em / 0.76 var(--display);
    font-stretch: 125%;
    letter-spacing: -0.035em;
    margin-top: -0.02em;
  }
  .lk-v {
    display: inline-block;
  }
  .lk-tag {
    font: 700 max(0.16em, 0.62rem) / 1.5 var(--display);
    font-stretch: 112%;
    letter-spacing: 0.16em;
    text-transform: uppercase;
  }

  /* ---- the film, once (only with motion allowed) ---- */
  :global(html:not(.m)) .term {
    display: none;
  }
  :global(.m) .pr {
    animation: slide 0.35s var(--ease) 0.45s backwards;
  }
  :global(.m) .typed {
    width: 0;
    animation: type 0.8s steps(16, end) 0.9s forwards;
  }
  :global(.m) .cur {
    animation: blink 0.9s steps(1) infinite;
  }
  :global(.m) .o {
    animation: line 0.3s var(--ease) calc(1.9s + var(--i) * 0.3s) backwards;
  }
  :global(.m) .o b {
    animation: pop 0.35s var(--ease) calc(2.1s + var(--i) * 0.3s) backwards;
  }
  :global(.m) .track i,
  :global(.m) .pct {
    animation: fill 1.1s cubic-bezier(0.6, 0, 0.2, 1) 3.1s backwards;
  }
  :global(.m) .term {
    animation: clear 0.45s var(--ease) 4.5s forwards;
  }
  :global(.m) .lockup {
    animation: arrive 0.6s var(--ease) 4.75s backwards;
  }
  :global(.m) .lk-chev {
    animation: tip 1s cubic-bezier(0.7, 0, 0.15, 1) 5.5s backwards;
  }
  :global(.m) .lk-v {
    animation: fade 0.45s ease 6.05s backwards;
  }
  :global(.m) .lk-blk {
    animation:
      drop 0.5s cubic-bezier(0.3, 1.5, 0.5, 1) 6.45s backwards,
      blink 1s steps(1) 7.2s 3;
  }
  :global(.m) .lk-tag {
    animation: wipe 0.9s steps(28) 6.7s backwards;
  }

  @property --pct {
    syntax: '<integer>';
    inherits: false;
    initial-value: 100;
  }
  @keyframes slide {
    from {
      opacity: 0;
      transform: translateX(-0.8em);
    }
  }
  @keyframes type {
    to {
      width: 16ch;
    }
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  @keyframes line {
    from {
      opacity: 0;
      transform: translateY(0.5em);
    }
  }
  @keyframes pop {
    from {
      opacity: 0;
      transform: scale(1.8);
    }
  }
  @keyframes fill {
    from {
      transform: scaleX(0);
      --pct: 0;
    }
  }
  @keyframes clear {
    to {
      opacity: 0;
      transform: translateY(-0.8em);
      visibility: hidden;
    }
  }
  @keyframes arrive {
    from {
      opacity: 0;
      transform: scale(0.94);
    }
  }
  /* the V of VCRR tips onto its side: it becomes the prompt */
  @keyframes tip {
    from {
      transform: translate(var(--vx), var(--vy)) rotate(90deg) scale(var(--vs));
    }
  }
  @keyframes fade {
    from {
      opacity: 0;
    }
  }
  @keyframes drop {
    from {
      opacity: 0;
      transform: translateY(-180%);
    }
  }
  @keyframes wipe {
    from {
      clip-path: inset(0 100% 0 0);
    }
  }

  /* ---- foot ---- */
  .foot {
    grid-column: 1 / -1;
    display: grid;
    grid-template-columns: subgrid;
    row-gap: 24px;
    padding-top: clamp(18px, 2vw, 28px);
    border-top: var(--rule) solid var(--paper);
  }
  .title {
    grid-column: 1 / 9;
    font-size: clamp(2.2rem, 4.9vw, 5.4rem);
    line-height: 0.88;
    text-transform: uppercase;
  }
  .side {
    grid-column: 9 / -1;
    display: grid;
    gap: 18px;
    align-content: start;
  }
  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    margin-top: 6px;
  }

  @media (max-width: 899px) {
    .hero {
      min-height: 0;
    }
    .meta-l,
    .screen,
    .title,
    .side {
      grid-column: 1 / -1;
    }
    .meta-r {
      display: none;
    }
    .screen {
      min-height: 240px;
    }
  }
</style>
