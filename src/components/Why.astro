---
import SectionHead from './SectionHead.astro';
import { risks, commitments } from '../data/site.ts';
---

<section id="why" class="section s-paper lines" aria-labelledby="why-title">
  <SectionHead index="05" label="Why VCRR" aside="Fragile / engineered" />
  <div class="wrap grid head">
    <h2 id="why-title" class="h-xl">Fragile software, or <span class="mark">engineered</span> systems.</h2>
    <p class="intro mu">
      None of these are dramatic. They are ordinary days that go wrong, and most of them can be designed out before the first line of code.
    </p>
  </div>

  <div class="wrap">
    <div class="diagram">
        <table class="cmp">
          <caption class="sr-only">Ordinary situations, how fragile software handles them, and how software engineered for them does</caption>
          <thead>
            <tr>
              <th scope="col" class="mono">Ref</th>
              <th scope="col" class="mono">Ordinary day</th>
              <th scope="col" class="mono">Fragile software</th>
              <th scope="col" class="mono">Engineered for it</th>
            </tr>
          </thead>
          <tbody>
            {
              risks.map((r, i) => (
                <tr class="rv">
                  <td class="mono ref">R.0{i + 1}</td>
                  <th scope="row">{r.title}</th>
                  <td class="without">{r.without}</td>
                  <td class="with">{r.with}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
    </div>

    <div class="commit">
      <h3 class="mono">What we put in writing</h3>
      <ul class="grid">
        {
          commitments.map((c, i) => (
            <li class="rv" style={`--d:${i}`}>
              <span class="mono">C.0{i + 1}</span>
              <h4>{c.title}</h4>
              <p class="mu">{c.body}</p>
            </li>
          ))
        }
      </ul>
    </div>
  </div>
</section>

<style>
  .head {
    row-gap: 20px;
    margin-bottom: clamp(24px, 3vw, 48px);
  }
  .head h2 {
    grid-column: 1 / 9;
  }
  .intro {
    grid-column: 9 / -1;
    align-self: end;
  }

  .diagram {
    margin-top: clamp(16px, 2vw, 32px);
  }
  .cmp {
    width: 100%;
    border-collapse: collapse;
    border: var(--rule) solid var(--ink);
    text-align: left;
  }
  .cmp thead th {
    background: var(--ink);
    color: var(--paper);
    padding: 14px 18px;
    font-weight: 500;
  }
  .cmp thead th:last-child {
    background: var(--accent);
    color: var(--ink);
  }
  .cmp td,
  .cmp tbody th {
    padding: clamp(16px, 2vw, 28px) 18px;
    border-top: var(--rule) solid var(--ink);
    vertical-align: top;
  }
  .cmp tbody th {
    width: 26%;
    font: 800 clamp(1.15rem, 1.7vw, 1.6rem) / 1.05 var(--display);
    font-stretch: 100%;
    text-transform: uppercase;
    letter-spacing: -0.01em;
  }
  .ref {
    width: 64px;
    color: var(--mu);
  }
  .without {
    color: var(--mu);
    border-right: 1px dashed rgb(20 17 15 / 0.3);
  }
  .with {
    font-weight: 600;
    box-shadow: inset 6px 0 0 var(--accent);
    padding-left: 26px !important;
  }
  .cmp tbody tr {
    transition: background-color 0.2s;
  }
  .cmp tbody tr:hover {
    background: rgb(255 176 0 / 0.22);
  }

  .commit {
    margin-top: clamp(48px, 7vw, 104px);
  }
  .commit h3 {
    margin-bottom: 20px;
  }
  .commit ul {
    row-gap: 28px;
  }
  .commit li {
    grid-column: span 3;
    display: grid;
    gap: 10px;
    align-content: start;
    padding-top: 16px;
    border-top: 4px solid var(--ink);
  }
  .commit li .mono {
    color: var(--hi);
  }
  .commit h4 {
    font: 700 1.25rem / 1.15 var(--body);
  }
  .commit p {
    font-size: var(--fs-small);
  }

  @media (max-width: 899px) {
    .head h2,
    .intro {
      grid-column: 1 / -1;
    }
    .commit li {
      grid-column: span 2;
    }
    /* the table becomes a stack of labelled records */
    .cmp,
    .cmp tbody,
    .cmp tr,
    .cmp td,
    .cmp tbody th {
      display: block;
      width: auto;
    }
    .cmp thead {
      display: none;
    }
    .cmp tbody tr {
      border-top: var(--rule) solid var(--ink);
    }
    .cmp tbody tr:first-child {
      border-top: 0;
    }
    .cmp td,
    .cmp tbody th {
      border: 0;
      padding: 6px 16px;
    }
    .cmp .ref {
      padding-top: 18px;
    }
    .cmp .with {
      margin: 6px 16px 18px;
      padding: 10px 14px !important;
      background: rgb(255 176 0 / 0.3);
      box-shadow: inset 4px 0 0 var(--ink);
    }
    .cmp td::before {
      display: block;
      font: 500 0.6875rem / 1.4 var(--mono);
      letter-spacing: 0.07em;
      text-transform: uppercase;
      color: var(--mu);
      margin-bottom: 2px;
    }
    .cmp .without::before {
      content: 'Fragile software';
    }
    .cmp .with::before {
      content: 'Engineered for it';
      color: var(--ink);
    }
    .without {
      border-right: 0;
    }
  }
  @media (max-width: 560px) {
    .commit li {
      grid-column: 1 / -1;
    }
  }
</style>
