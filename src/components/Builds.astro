---
import SectionHead from './SectionHead.astro';
import { builds } from '../data/site.ts';
---

<section id="builds" class="section s-ink lines" aria-labelledby="builds-title">
  <SectionHead index="03" label="What we build" aside={`ls ~/vcrr/builds — ${builds.length} of many`} />
  <div class="wrap grid head">
    <h2 id="builds-title" class="h-xl">Whatever your business <span class="mark">runs on.</span></h2>
    <p class="intro">
      Examples, not a menu. If your business needs it and it is software, we scope it from your requirements and build it.
    </p>
  </div>

  <div class="wrap">
    <ol class="cat">
      {
        builds.map((b, i) => (
          <li class="rv" style={`--d:${i % 3}`}>
            <span class="mono n">{String(i + 1).padStart(2, '0')}</span>
            <h3>{b.name}</h3>
            <p>{b.eg}</p>
          </li>
        ))
      }
      <li class="more s-amber">
        <p class="more-h">Not on the list? <span>That is the point.</span></p>
        <a class="btn" href="#contact">Describe your requirement <span class="arr" aria-hidden="true">→</span></a>
      </li>
    </ol>
  </div>
</section>

<style>
  .head {
    row-gap: 20px;
    margin-bottom: clamp(40px, 6vw, 88px);
  }
  .head h2 {
    grid-column: 1 / 9;
  }
  .intro {
    grid-column: 9 / -1;
    align-self: end;
    color: var(--mu);
  }
  .cat {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    border-top: var(--rule) solid var(--fg);
    border-left: var(--rule) solid var(--fg);
  }
  .cat li {
    display: grid;
    align-content: start;
    gap: 10px;
    padding: clamp(18px, 2vw, 30px);
    border-right: var(--rule) solid var(--fg);
    border-bottom: var(--rule) solid var(--fg);
    transition:
      background-color 0.25s var(--ease),
      color 0.25s var(--ease);
  }
  .n {
    color: var(--hi);
  }
  .cat h3 {
    font-size: clamp(1.2rem, 1.7vw, 1.6rem);
    font-stretch: 105%;
    line-height: 1;
    text-transform: uppercase;
  }
  .cat p {
    color: var(--mu);
    font-size: var(--fs-small);
  }
  .cat li:not(.more):hover {
    background: var(--accent);
    color: var(--ink);
  }
  .cat li:not(.more):hover :is(.n, p) {
    color: var(--ink);
  }
  .more {
    grid-column: 1 / -1;
    display: flex !important;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 20px 32px;
  }
  .more-h {
    font: 800 var(--fs-l) / 1 var(--display);
    font-stretch: 110%;
    text-transform: uppercase;
  }
  .more-h span {
    display: block;
  }

  @media (max-width: 1080px) {
    .cat {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }
  @media (max-width: 899px) {
    .head h2,
    .intro {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 600px) {
    .cat {
      grid-template-columns: minmax(0, 1fr);
    }
  }
</style>
