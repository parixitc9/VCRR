---
import SectionHead from './SectionHead.astro';
import { site, isPlaceholder, channels, projectTypes, budgets } from '../data/site.ts';

// Integration point: set PUBLIC_INQUIRY_ENDPOINT (see README) and the form POSTs JSON there.
// Without it the form validates and prepares the brief, and says plainly that nothing was sent.
const endpoint = import.meta.env.PUBLIC_INQUIRY_ENDPOINT || '';
const email = isPlaceholder(site.email) ? '' : site.email;
---

<section id="contact" class="section s-amber lines" aria-labelledby="contact-title">
  <SectionHead index="07" label="Contact / Project inquiry" aside="Brief → conversation → scope" />
  <div class="wrap grid layout">
    <div class="left">
      <h2 id="contact-title" class="title">Have a complex problem? <span class="good">Good.</span></h2>
      <div class="next">
        <h3 class="mono">What happens next</h3>
        <ol>
          <li>We read your brief and reply to arrange a conversation, or tell you honestly if we are not the right fit.</li>
          <li>In that conversation we ask how the work happens today. No preparation needed.</li>
          <li>If it makes sense to continue, we propose a discovery phase with a written scope and cost.</li>
        </ol>
      </div>
      <div class="direct">
        <h3 class="mono">Prefer to talk directly?</h3>
        <ul>
          {
            channels().map((c) => (
              <li>
                <span class="mono">{c.label}</span>
                {c.href ? <a href={c.href}>{c.value}</a> : <span>{c.value}</span>}
              </li>
            ))
          }
        </ul>
      </div>
    </div>

    <div class="panel s-paper">
      <form class="form" novalidate data-inquiry data-endpoint={endpoint} data-email={email}>
        <p class="mono form-head"><span>Project brief</span><span class="mu">* required</span></p>
        <!-- spam trap: hidden from people. A backend must discard submissions where it is filled. -->
        <div class="trap" aria-hidden="true">
          <label>Website <input name="website" tabindex="-1" autocomplete="off" /></label>
        </div>

        <div class="row two">
          <div class="field">
            <label for="name">Name <span aria-hidden="true">*</span></label>
            <input id="name" name="name" autocomplete="name" required maxlength="120" aria-describedby="name-error" />
            <p class="error" id="name-error"></p>
          </div>
          <div class="field">
            <label for="email">Business email <span aria-hidden="true">*</span></label>
            <input id="email" name="email" type="email" autocomplete="email" required maxlength="160" aria-describedby="email-error" />
            <p class="error" id="email-error"></p>
          </div>
        </div>
        <div class="row two">
          <div class="field">
            <label for="company">Company <span class="opt">(optional)</span></label>
            <input id="company" name="company" autocomplete="organization" maxlength="160" />
          </div>
          <div class="field">
            <label for="projectType">Project type <span aria-hidden="true">*</span></label>
            <select id="projectType" name="projectType" required aria-describedby="projectType-error">
              <option value="">Choose one</option>
              {projectTypes.map((t) => <option>{t}</option>)}
            </select>
            <p class="error" id="projectType-error"></p>
          </div>
        </div>
        <div class="field">
          <label for="budget">Budget range <span class="opt">(optional)</span></label>
          <select id="budget" name="budget" aria-describedby="budget-hint budget-error">
            <option value="">Choose one</option>
            {budgets.map((b) => <option>{b}</option>)}
          </select>
          <p class="hint" id="budget-hint">Indicative only. It helps us suggest a sensible first scope.</p>
          <p class="error" id="budget-error"></p>
        </div>
        <div class="field">
          <label for="description">What is the problem? <span aria-hidden="true">*</span></label>
          <textarea
            id="description"
            name="description"
            required
            minlength="20"
            maxlength="2000"
            rows="5"
            aria-describedby="description-hint description-error"></textarea>
          <p class="hint" id="description-hint">What is slow, error-prone or frustrating, and who feels it. A few sentences is enough.</p>
          <p class="error" id="description-error"></p>
        </div>

        <div class="submit">
          <button class="btn" type="submit" data-submit>
            <span data-label>{endpoint ? 'Send brief' : 'Prepare brief'}</span>
            <span class="arr" aria-hidden="true">→</span>
          </button>
          <p class="mono mu">Used only to reply about this project.</p>
        </div>
      </form>

      <div class="state" data-manual hidden tabindex="-1">
        <p class="mono state-k">Not sent — online sending is not connected yet</p>
        <p>Your brief is ready but has not been sent anywhere. Copy it, or open it in your email app, and send it to us directly.</p>
        <div class="state-actions">
          <button type="button" class="btn" data-copy>Copy brief</button>
          {
            email ? (
              <a class="btn btn-ghost" data-mail href={`mailto:${email}`}>
                Open in email app
              </a>
            ) : (
              <button type="button" class="btn btn-ghost" disabled aria-describedby="no-email">
                Open in email app
              </button>
            )
          }
        </div>
        {!email && <p class="mono mu" id="no-email">The studio email address has not been configured yet.</p>}
        <p class="mono" role="status" data-copy-status></p>
      </div>

      <div class="state" data-sent hidden tabindex="-1">
        <p class="mono state-k">Received</p>
        <p class="sent-h">Thank you. Your brief arrived.</p>
        <p>We will reply by email. If it makes sense to continue, the next step is a conversation about how the work happens today.</p>
      </div>

      <div class="state err" data-error hidden role="alert">
        <p class="mono state-k">Not sent</p>
        <p>Something went wrong and nothing was delivered. Your answers are still in the form. Try again, or copy the brief and email it.</p>
        <button type="button" class="btn btn-ghost" data-copy>Copy brief</button>
      </div>
    </div>
  </div>
</section>

<script>
  import { FIELDS, validate, briefText, type Field, type Inquiry } from '../lib/inquiry.ts';

  const form = document.querySelector<HTMLFormElement>('[data-inquiry]')!;
  const panel = form.parentElement!;
  const manual = panel.querySelector<HTMLElement>('[data-manual]')!;
  const sent = panel.querySelector<HTMLElement>('[data-sent]')!;
  const failed = panel.querySelector<HTMLElement>('[data-error]')!;
  const submit = form.querySelector<HTMLButtonElement>('[data-submit]')!;
  const label = submit.querySelector('[data-label]')!;
  const { endpoint, email } = form.dataset;
  const options = (name: string) => [...form.querySelectorAll<HTMLOptionElement>(`select[name="${name}"] option`)].map((o) => o.value).filter(Boolean);
  const types = options('projectType');
  const budgets = options('budget');

  const control = (f: Field) => form.elements.namedItem(f) as HTMLInputElement;
  const read = () => Object.fromEntries(FIELDS.map((f) => [f, control(f).value])) as Inquiry;

  function show(errors: Partial<Record<Field, string>>, only?: Field) {
    for (const f of only ? [only] : FIELDS) {
      const out = document.getElementById(`${f}-error`);
      if (!out) continue;
      out.textContent = errors[f] ?? '';
      control(f).setAttribute('aria-invalid', String(!!errors[f]));
    }
  }

  // once a field has been flagged, re-check it while the visitor corrects it
  form.addEventListener('input', (e) => {
    const f = (e.target as HTMLInputElement).name as Field;
    if (control(f)?.getAttribute('aria-invalid') === 'true') show(validate(read(), types, budgets), f);
  });

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = read();
    const errors = validate(data, types, budgets);
    show(errors);
    const first = FIELDS.find((f) => errors[f]);
    if (first) return control(first).focus();
    failed.hidden = true;

    if (!endpoint) {
      const mail = manual.querySelector<HTMLAnchorElement>('[data-mail]');
      if (mail && email) {
        const subject = `Project brief: ${data.company.trim() || data.name.trim()}`;
        mail.href = `mailto:${email}?subject=${encodeURIComponent(subject)}&body=${encodeURIComponent(briefText(data))}`;
      }
      manual.hidden = false;
      manual.focus();
      return;
    }

    submit.disabled = true;
    submit.setAttribute('aria-busy', 'true');
    label.textContent = 'Sending…';
    try {
      const body = JSON.stringify({ ...data, website: (form.elements.namedItem('website') as HTMLInputElement).value });
      const res = await fetch(endpoint, { method: 'POST', headers: { 'Content-Type': 'application/json' }, body });
      if (!res.ok) throw new Error(String(res.status));
      form.hidden = true;
      sent.hidden = false;
      sent.focus();
    } catch {
      failed.hidden = false; // never show success for a brief that was not delivered
    } finally {
      submit.disabled = false;
      submit.removeAttribute('aria-busy');
      label.textContent = 'Send brief';
    }
  });

  const status = manual.querySelector('[data-copy-status]')!;
  panel.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((b) =>
    b.addEventListener('click', async () => {
      try {
        await navigator.clipboard.writeText(briefText(read()));
        status.textContent = 'Copied. Paste it into an email or message to us.';
        b.textContent = 'Copied';
        setTimeout(() => (b.textContent = 'Copy brief'), 2500);
      } catch {
        status.textContent = 'Copying is blocked in this browser. Select the text in the form and copy it manually.';
      }
    }),
  );
</script>

<style>
  .layout {
    row-gap: 48px;
    align-items: start;
  }
  .left {
    grid-column: 1 / 6;
    display: grid;
    gap: clamp(28px, 4vw, 48px);
  }
  .title {
    font-size: clamp(2.6rem, 6.2vw, 6.6rem);
    text-transform: uppercase;
    line-height: 0.88;
  }
  .good {
    display: inline-block;
    margin-top: 0.08em;
    padding: 0 0.12em;
    background: var(--ink);
    color: var(--accent);
    transform: rotate(-2deg);
  }
  .next h3,
  .direct h3 {
    margin-bottom: 12px;
  }
  .next ol {
    display: grid;
    gap: 10px;
    counter-reset: n;
  }
  .next li {
    display: grid;
    grid-template-columns: 36px 1fr;
    font-size: var(--fs-small);
    counter-increment: n;
  }
  .next li::before {
    content: '0' counter(n);
    font: 500 var(--fs-mono) / 1.9 var(--mono);
  }
  .direct ul {
    display: grid;
    border-top: var(--rule) solid var(--ink);
  }
  .direct li {
    display: flex;
    justify-content: space-between;
    gap: 16px;
    padding: 10px 0;
    border-bottom: 1px solid var(--ln);
    font-weight: 600;
    overflow-wrap: anywhere;
  }

  /* ---- the form: a document pinned to the amber wall ---- */
  .panel {
    grid-column: 7 / -1;
    padding: clamp(20px, 3vw, 40px);
    border: var(--rule) solid var(--ink);
    box-shadow: 12px 12px 0 var(--ink);
    --err: #b8250e;
  }
  .form {
    display: grid;
    gap: 22px;
  }
  .form-head {
    display: flex;
    justify-content: space-between;
    padding-bottom: 14px;
    border-bottom: var(--rule) solid var(--ink);
  }
  .row.two {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 22px;
  }
  .field {
    display: grid;
    gap: 7px;
    align-content: start;
  }
  label {
    font: 500 var(--fs-mono) / 1.4 var(--mono);
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }
  .opt {
    color: var(--mu);
  }
  input,
  select,
  textarea {
    width: 100%;
    min-height: 52px;
    padding: 12px 14px;
    border: var(--rule) solid var(--ink);
    border-radius: 0;
    background: #fbfaf6;
    font-size: 1rem;
    transition:
      box-shadow 0.15s,
      background-color 0.15s;
  }
  select {
    appearance: none;
    background-image: linear-gradient(45deg, transparent 50%, var(--ink) 50%), linear-gradient(-45deg, transparent 50%, var(--ink) 50%);
    background-position:
      calc(100% - 22px) 50%,
      calc(100% - 16px) 50%;
    background-size: 6px 6px;
    background-repeat: no-repeat;
    padding-right: 40px;
  }
  textarea {
    resize: vertical;
    min-height: 140px;
    line-height: 1.5;
  }
  input:focus-visible,
  select:focus-visible,
  textarea:focus-visible {
    outline: none;
    background: #fff;
    box-shadow: 5px 5px 0 var(--hi);
  }
  [aria-invalid='true'] {
    border-color: var(--err);
    box-shadow: inset 4px 0 0 var(--err);
  }
  .hint {
    font-size: 0.875rem;
    color: var(--mu);
  }
  .error {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--err);
  }
  .error:empty {
    display: none;
  }
  .trap {
    position: absolute;
    left: -10000px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }
  .submit {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 24px;
    padding-top: 6px;
  }
  .submit .btn {
    min-width: 220px;
  }

  .state {
    display: grid;
    gap: 14px;
    justify-items: start;
    margin-top: 28px;
    padding: 20px;
    border: var(--rule) solid var(--ink);
    background: var(--paper-2);
  }
  [data-sent] {
    margin-top: 0;
  }
  .state:focus {
    outline: 3px solid var(--hi);
    outline-offset: 3px;
  }
  .state-k {
    padding: 3px 8px;
    background: var(--ink);
    color: var(--accent);
  }
  .err .state-k {
    background: var(--err);
    color: #fff;
  }
  .state-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
  }
  .sent-h {
    font: 800 var(--fs-l) / 1 var(--display);
    text-transform: uppercase;
  }

  @media (max-width: 1080px) {
    .left,
    .panel {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 560px) {
    .row.two {
      grid-template-columns: minmax(0, 1fr);
    }
    .panel {
      box-shadow: 6px 6px 0 var(--ink);
    }
  }
</style>
