---
import Base from '../layouts/Base.astro';
import Hero from '../components/Hero.astro';
import Manifesto from '../components/Manifesto.astro';
import Services from '../components/Services.astro';
import Work from '../components/Work.astro';
import Builds from '../components/Builds.astro';
import Why from '../components/Why.astro';
import Process from '../components/Process.astro';
import Contact from '../components/Contact.astro';
import { site } from '../data/site.ts';
---

<Base title={`${site.name} — Any software, built to your requirements`} description={site.description}>
  <Hero />
  <Manifesto />
  <Services />
  <Builds />
  <Work />
  <Why />
  <Process />
  <Contact />
</Base>
